{
  "name": "instanct",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=./apps/* --continue",
    "dev:web": "turbo run dev --filter=instanct-ui",
    "dev:landing": "turbo run dev --filter=instanct-landing",
    "dev:mobile": "turbo run dev --filter=instanct-mobile-app",
    "dev:api": "turbo run start:dev --filter=instanct-api",
    "dev:data-flow": "turbo run dev --filter=instanct-data-flow",
    "data-flow": "pnpm --filter instanct-data-flow build && pnpm --filter instanct-data-flow start:prod",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check:expo": "node ./scripts/check-expo.mjs",
    "check-types": "pnpm run check:shared-deps && turbo run check-types",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.5",
    "prettier": "3.9.6",
    "turbo": "^2.11.2",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.25.0"
  },
  "dependencies": {
    "expo": "58.0.7",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.4",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "4.7.0",
    "react-native-worklets": "0.13.0"
  }
}
