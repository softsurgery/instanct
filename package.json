{
  "name": "instanct",
  "private": true,
  "scripts": {
    "build": "node ./packages/softsurgery-abstractions/scripts/mjs/build-softsurgery-abstractions.mjs && turbo run build",
    "dev": "turbo run dev --concurrency=8 --filter=./apps/* --filter=./packages/api-client --filter=./packages/i18n",
    "dev:abstractions": "pnpm --filter \"./packages/softsurgery-abstractions/*\" --parallel --workspace-concurrency=3 --no-sort run dev",
    "dev:web": "turbo run dev --filter=instanct-ui",
    "dev:landing": "turbo run dev --filter=instanct-landing",
    "dev:mobile": "turbo run dev --filter=instanct-mobile-app",
    "dev:api": "turbo run start:dev --filter=instanct-api",
    "lint": "pnpm run format && turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check:expo": "node ./packages/softsurgery-abstractions/scripts/mjs/check-expo.mjs",
    "check:shared-deps": "node ./packages/softsurgery-abstractions/scripts/mjs/sync-shared-deps.mjs",
    "check-types": "pnpm run check:shared-deps && turbo run check-types",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.5",
    "prettier": "3.9.6",
    "turbo": "^2.11.2",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.25.0"
  },
  "dependencies": {
    "expo": "58.0.23",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  }
}