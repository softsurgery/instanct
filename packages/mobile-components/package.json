{
  "name": "@softsurgery/mobile-components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./contexts/*": "./src/contexts/*.tsx"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf node_modules .next dist build .turbo"
  },
  "dependencies": {
    "@softsurgery/hooks": "workspace:*",
    "@softsurgery/lib": "workspace:*",
    "@softsurgery/mobile-ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.1.0"
  },
  "peerDependencies": {
    "@react-native-masked-view/masked-view": "*",
    "@react-native-ohos/react-native-keyboard-aware-scroll-view": "*",
    "@react-navigation/material-top-tabs": "*",
    "@react-navigation/native": "*",
    "expo": "58.0.7",
    "expo-haptics": "*",
    "expo-image": "*",
    "expo-linear-gradient": "*",
    "expo-localization": "*",
    "expo-navigation-bar": "*",
    "expo-router": "*",
    "expo-video": "*",
    "i18next": "*",
    "lottie-react-native": "*",
    "lucide-react-native": "*",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-i18next": "*",
    "react-native": "0.88.0-rc.4",
    "react-native-actions-sheet": "*",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": "4.7.0",
    "react-native-render-html": "*",
    "react-native-safe-area-context": "*"
  }
}
