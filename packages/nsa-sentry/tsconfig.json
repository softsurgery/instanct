{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2023",
    "strictNullChecks": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "outDir": "./dist",
    "strict": false,
    "strictPropertyInitialization": false,
    "noEmit": true,
    "paths": {
      "nsa-auth/*": [
        "../nsa-auth/src/*"
      ],
      "nsa-chat/*": [
        "../nsa-chat/src/*"
      ],
      "nsa-configurations/*": [
        "../nsa-configurations/src/*"
      ],
      "nsa-content/*": [
        "../nsa-content/src/*"
      ],
      "nsa-helpers/*": [
        "../nsa-helpers/src/*"
      ],
      "nsa-logger/*": [
        "../nsa-logger/src/*"
      ],
      "nsa-mail/*": [
        "../nsa-mail/src/*"
      ],
      "nsa-notifications/*": [
        "../nsa-notifications/src/*"
      ],
      "nsa-reference-types/*": [
        "../nsa-reference-types/src/*"
      ],
      "nsa-sessions/*": [
        "../nsa-sessions/src/*"
      ],
      "nsa-storage/*": [
        "../nsa-storage/src/*"
      ],
      "nsa-templates/*": [
        "../nsa-templates/src/*"
      ],
      "nsa-um/*": [
        "../nsa-um/src/*"
      ],
      "nsa-workflows/*": [
        "../nsa-workflows/src/*"
      ],
      "src/*": [
        "../../apps/api/src/*"
      ],
      "@/*": [
        "../../apps/api/src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
