{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "nativewind",
    "declaration": false,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "react-native": ["../../node_modules/react-native/types_generated/index.d.ts"],
      "@softsurgery/lib": ["../lib/src/index.ts"],
      "@softsurgery/lib/*": ["../lib/src/*"]
    }
  },
  "include": ["src/**/*", "nativewind-env.d.ts"],
  "exclude": ["dist", "node_modules"]
}
