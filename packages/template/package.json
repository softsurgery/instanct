{
  "name": "@softsurgery/template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx",
      "./src/*"
    ]
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf node_modules .next dist build .turbo"
  },
  "dependencies": {
    "@instanct/components": "workspace:*",
    "@instanct/contexts": "workspace:*",
    "@instanct/datatable-builder": "workspace:*",
    "@instanct/form-builder": "workspace:*",
    "@instanct/hooks": "workspace:*",
    "@instanct/lib": "workspace:*",
    "@instanct/ui": "workspace:*",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^0.441.0",
    "react-i18next": "^15.0.2",
    "sonner": "^2.0.7",
    "zustand": "^5.0.8"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^15.0.2"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
