    "build": "tsc --noEmit",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@instanct/hooks": "workspace:*",
    "@instanct/lib": "workspace:*",
    "axios": "^1.12.2"
  },
  "devDependencies": {
    "typescript": "^5.5.3"
  }
}
