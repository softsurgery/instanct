{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@softsurgery/hooks": [
        "./src/index.ts"
      ],
      "@softsurgery/hooks/*": [
        "./src/*"
      ],
      "@softsurgery/lib": [
        "../lib/src/index.ts"
      ],
      "@softsurgery/lib/*": [
        "../lib/src/*"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
