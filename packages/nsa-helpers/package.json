{
  "name": "nsa-helpers",
  "version": "0.1.0",
  "private": true,
  "description": "Instanct shared helpers module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*/*": {
      "types": "./dist/*/*.d.ts",
      "default": "./dist/*/*.js"
    },
    "./*/*/*": {
      "types": "./dist/*/*/*.d.ts",
      "default": "./dist/*/*/*.js"
    },
    "./*/*/*/*": {
      "types": "./dist/*/*/*/*.d.ts",
      "default": "./dist/*/*/*/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-shared-packages.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.0.0",
    "nsa-notifications": "workspace:*",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "typescript": "5.9.3"
  }
}
