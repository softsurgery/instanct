{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "#lib/*": [
        "./src/lib/*"
      ],
      "#components/*": [
        "./src/components/*"
      ],
      "#hooks/*": [
        "./src/hooks/*"
      ],
      "@instanct/ui/*": [
        "./src/*"
      ],
      "@instanct/lib": [
        "../lib/src/index.ts"
      ],
      "@instanct/lib/*": [
        "../lib/src/*"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src/**/*"
  ]
}
