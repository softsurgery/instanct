{
  "name": "@instanct/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "check-types": "tsc --noEmit"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "imports": {
    "#lib/*": "./src/lib/*.ts",
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles/*.css": "./src/styles/*.css",
    "./components/video.css": "./src/components/video.css",
    "./components/editor/style.css": "./src/components/editor/style.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": [
      "./src/hooks/*.ts",
      "./src/hooks/*.tsx"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@tanstack/react-table": "^8.20.5",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-character-count": "^3.31.3",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-subscript": "^3.31.3",
    "@tiptap/extension-superscript": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@videojs/hlsjs-video": "10.0.0-rc.2",
    "@videojs/react": "10.0.0-rc.2",
    "@videojs/youtube-video": "10.0.0-rc.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^23.15.1",
    "lowlight": "^3.3.0",
    "lucide-react": ">=0.400.0 <1.0.0",
    "next-themes": "^0.4.6",
    "@stepperize/react": "^5.1.9",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.1",
    "react-colorful": "^5.6.1",
    "react-i18next": "^15.0.2",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "@instanct/lib": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5.5.3"
  }
}
