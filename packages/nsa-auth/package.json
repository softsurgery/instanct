{
  "name": "nsa-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Instanct shared auth module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*/*": {
      "types": "./dist/*/*.d.ts",
      "default": "./dist/*/*.js"
    },
    "./*/*/*": {
      "types": "./dist/*/*/*.d.ts",
      "default": "./dist/*/*/*.js"
    },
    "./*/*/*/*": {
      "types": "./dist/*/*/*/*.d.ts",
      "default": "./dist/*/*/*/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-shared-packages.mjs",
    "clean": "rm -rf node_modules .next dist build .turbo"
  },
  "dependencies": {
    "@faker-js/faker": "^9.8.0",
    "@nestjs-cls/transactional": "^2.4.2",
    "@nestjs-cls/transactional-adapter-typeorm": "^1.2.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^5.0.0",
    "google-auth-library": "^10.4.2",
    "nsa-um": "workspace:*",
    "nsa-configurations": "workspace:*",
    "nsa-database": "workspace:*",
    "nsa-helpers": "workspace:*",
    "nsa-logger": "workspace:*",
    "nsa-mail": "workspace:*",
    "nsa-notifications": "workspace:*",
    "nsa-storage": "workspace:*",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "typescript": "5.9.3"
  }
}
