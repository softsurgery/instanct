<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bug Report Resolved</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body style="
      font-family: sans-serif;
      color: #343a40;
      max-width: 600px;
      margin: auto;
      padding: 20px;
    ">
  <div class="text-center mb-4">
    <% if (typeof logo !=='undefined' && logo) { %>
      <img src="<%= logo %>" alt="<%= typeof name !== 'undefined' ? name : '' %>"
        style="max-height: 64px; margin-bottom: 20px" />
      <% } %>
        <h1 class="text-primary fs-4 fw-bold">
          <%= typeof name !=='undefined' && name ? name : 'Bug Report Resolved' %>
        </h1>
  </div>

  <div class="bg-light p-4 rounded mb-4 shadow-sm">
    <h2 class="fs-5 fw-semibold mb-3">Hello <%= typeof client !=='undefined' ? client : 'Valued User' %>,</h2>

    <p class="mb-3">
      A bug report you expressed interest in has just been marked as <strong>Resolved</strong>.
    </p>

    <div class="bg-white p-3 rounded border mb-3">
      <div class="text-muted small text-uppercase fw-semibold mb-1">
        Bug #<%= typeof bugId !=='undefined' ? bugId : '' %> &bull; <%= typeof variant !=='undefined' ? variant : '' %>
      </div>
      <h3 class="fs-6 fw-bold mb-2 text-dark">
        <%= typeof title !=='undefined' ? title : '' %>
      </h3>
      <p class="mb-0 text-secondary" style="white-space: pre-wrap;">
        <%= typeof description !=='undefined' ? description : '' %>
      </p>
    </div>

    <p class="mb-0 text-secondary">
      Thank you for your valuable interest and patience while we worked on resolving this issue.
    </p>
  </div>

  <div class="border-top pt-4 text-muted small">
    <% if (typeof support !=='undefined' && support) { %>
      <p class="fw-semibold mb-2">Need Help?</p>
      <p class="mb-4">
        If you have any questions or need assistance, please don't hesitate to contact our support team at
        <a href="mailto:<%= support %>" class="text-primary text-decoration-none">
          <%= support %>
        </a>
      </p>
      <% } %>

        <p class="mb-4">
          Best regards,<br />
          The <%= typeof name !=='undefined' && name ? name : 'Support' %> Team
        </p>

        <div class="pt-3 border-top text-secondary small">
          <% if (typeof address !=='undefined' && address) { %>
            <p>
              <%= typeof name !=='undefined' && name ? name : '' %><br />
                <%= address %>
            </p>
            <% } %>
              <p class="mt-3">
                This email was sent automatically because you were added to the interested users list for this bug
                report.
              </p>
        </div>
  </div>
</body>

</html>