NODE_ENV=development

APP_HOST=api.instanct.com
APP_PORT=5000
APP_SECURE=true
APP_PUBLIC_URL=https://api.instanct.com


APP_NAME="Instanct API Server"
API_PREFIX=api
APP_LANGUAGE=en

DATABASE_TYPE=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=password
DATABASE_NAME=instanct
DATABASE_SYNCHRONIZE=false
DATABASE_DROP_SCHEMA=false
DATABASE_LOGGING=false
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
DATABASE_URL=

HTTP_ENABLE=true

JWT_SECRET=secret
JWT_ACCESS_EXPIRATION=1d
JWT_REFRESH_EXPIRATION=3d

GITHUB_ID=github-client-id
GITHUB_SECRET=github-client-secret

GOOGLE_ID=google-client-id
GOOGLE_SECRET=google-client-secret

LINKEDIN_CLIENT_ID=linkedin-client-id
LINKEDIN_CLIENT_SECRET=linkedin-client-secret

APPLE_CLIENT_ID=apple-client-id
APPLE_TEAM_ID=apple-team-id

SMTP_HOST=smtp-host
SMTP_PORT=smpt-port
SMTP_USER=smtp-user
SMTP_PASS=smtp-pass
SMTP_SECURE=true
SMTP_REJECT_UNAUTHORIZED=false

STORAGE_DRIVER=s3

S3_BUCKET=uploads
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=your_aws_access_key
S3_SECRET_KEY=your_aws_secret_key

UPLOAD_PATH=/path/to/upload

# BugSink DSN (Sentry-compatible)
# Release is always <package.json name>@<version>
SENTRY_DSN=