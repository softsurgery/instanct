{
  "extends": "../../packages/softsurgery-abstractions/typescript-config/nestjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "incremental": true,
    "baseUrl": ".",
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "types": ["node", "jest", "multer"],
    "paths": {
      "@/*": ["./src/*"],
      "src/*": ["./src/*"],
      "typeorm": ["../../node_modules/typeorm"],
      "typeorm/*": ["../../node_modules/typeorm/*"]
    }
  }
}
