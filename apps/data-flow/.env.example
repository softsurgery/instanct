# Copy to apps/backup/.env or export these before `pnpm backup`.
# Database variables match the API env file. Values already in the environment win.
# In Docker, mount the key at /secrets/gdrive-service-account.json.

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_NAME=instanct
DATABASE_SSL_ENABLED=false

# Google Drive
# 1. Enable the Google Drive API and create a service account.
# 2. Save its JSON key outside the repo and point this at that file.
# 3. Create a Drive folder and share it with the service-account email as Editor.
#    A service account cannot upload into My Drive itself.
# 4. Paste the folder id, or the full /folders/<id> URL.
GDRIVE_FOLDER_ID=gdrive-folder-id
GDRIVE_SERVICE_ACCOUNT_FILE=google-service-account.json

# Local copy of each dump. Defaults to ~/instanct-backups.
BACKUP_DIR=
# Delete local and Drive copies older than this many days. 0 keeps every backup.
BACKUP_RETENTION_DAYS=14
