EXPO_PUBLIC_MODE=development
EXPO_PUBLIC_API_BASE_URL=http://domain.com/
EXPO_PUBLIC_API_SOCKET_URL=http://domain.com/
EXPO_PUBLIC_GLOBAL_DELAY=0

GOOGLE_MAPS_API_KEY=google-maps-api-key

EXPO_PUBLIC_GOOGLE_CLIENT_ID=google-client-id
EXPO_PUBLIC_LINKEDIN_CLIENT_ID=linkedin-client-id

EXPO_PUBLIC_OAUTH_REDIRECT_URI=http://domain.com/

# BugSink DSN (Sentry-compatible)
# Release is instanct-mobile-app@<package.json version>
EXPO_PUBLIC_SENTRY_DSN=

# Optional: source-map upload for native builds (self-hosted Sentry / BugSink)
SENTRY_URL=
SENTRY_ORG=
SENTRY_PROJECT=
