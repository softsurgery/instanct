NEXTAUTH_SECRET=secret

GITHUB_ID=github-client-id
GITHUB_SECRET=github-client-secret

GOOGLE_ID=google-client-id
GOOGLE_SECRET=google-client-secret

APPLE_CLIENT_ID=apple-client-id
