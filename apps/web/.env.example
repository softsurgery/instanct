NEXT_PUBLIC_BASE_URL=https://api.instanct.com/api
BASE_URL=http://localhost:5000/api

# BugSink DSN (Sentry-compatible)
# Release is always <package.json name>@<version>
NEXT_PUBLIC_SENTRY_DSN=