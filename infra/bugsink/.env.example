# Bugsink Server Configuration
PORT=8000
BUGSINK_PORT=7777
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-characters
CREATE_SUPERUSER=admin@instanct.com:your_admin_password
BASE_URL=http://localhost:7777
BEHIND_HTTPS_PROXY=false

# SQLite Database Configuration (persisted in /data volume)
DATABASE_PATH=/data/db.sqlite3
