{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "concurrency": "20",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": []
    },
    "check-types": {
      "dependsOn": []
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start:dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@softsurgery/nsa-um#build": {
      "dependsOn": ["@softsurgery/nsa-database#build"],
      "cache": false
    },
    "@softsurgery/nsa-auth#build": {
      "dependsOn": ["@softsurgery/nsa-database#build"],
      "cache": false
    },
    "@softsurgery/nsa-chat#build": {
      "dependsOn": ["@softsurgery/nsa-database#build"],
      "cache": false
    },
    "@softsurgery/nsa-configurations#build": {
      "dependsOn": ["@softsurgery/nsa-database#build"],
      "cache": false
    },
    "@softsurgery/nsa-content#build": {
      "dependsOn": ["@softsurgery/nsa-database#build"],
      "cache": false
    },
    "@softsurgery/nsa-helpers#build": {
      "dependsOn": ["@softsurgery/nsa-database#build"],
      "cache": false
    },
    "@softsurgery/nsa-logger#build": {
      "dependsOn": ["@softsurgery/nsa-database#build"],
      "cache": false
    },
    "@softsurgery/nsa-mail#build": {
      "dependsOn": ["@softsurgery/nsa-database#build"],
      "cache": false
    },
    "@softsurgery/nsa-notifications#build": {
      "dependsOn": ["@softsurgery/nsa-database#build"],
      "cache": false
    },
    "@softsurgery/nsa-reference-types#build": {
      "dependsOn": ["@softsurgery/nsa-database#build"],
      "cache": false
    },
    "@softsurgery/nsa-sentry#build": {
      "dependsOn": ["@softsurgery/nsa-database#build"],
      "cache": false
    },
    "@softsurgery/nsa-sessions#build": {
      "dependsOn": ["@softsurgery/nsa-database#build"],
      "cache": false
    },
    "@softsurgery/nsa-storage#build": {
      "dependsOn": ["@softsurgery/nsa-database#build"],
      "cache": false
    },
    "@softsurgery/nsa-templates#build": {
      "dependsOn": ["@softsurgery/nsa-database#build"],
      "cache": false
    },
    "@softsurgery/nsa-workflows#build": {
      "dependsOn": ["@softsurgery/nsa-database#build"],
      "cache": false
    }
  }
}
